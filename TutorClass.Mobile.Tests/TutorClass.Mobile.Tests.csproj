<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <!-- Test the exact platform-independent source used by the Android app. -->
    <Compile Include="../TutorClass.Mobile/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../TutorClass.Mobile/Services/SessionService.cs" Link="Services/SessionService.cs" />
    <Compile Include="../TutorClass.Mobile/Services/ComunicacaoServices.cs" Link="Services/ComunicacaoServices.cs" />
    <Compile Include="../TutorClass.Mobile/Services/PlanoService.cs" Link="Services/PlanoService.cs" />
    <Compile Include="../TutorClass.Mobile/Services/EstudosServices.cs" Link="Services/EstudosServices.cs" />
    <Compile Include="../TutorClass.Mobile/Services/ProfessorService.cs" Link="Services/ProfessorService.cs" />
    <Compile Include="../TutorClass.Mobile/ViewModels/*.cs" Link="ViewModels/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>




